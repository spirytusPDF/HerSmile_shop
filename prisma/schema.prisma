generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Product {
  id          Int      @id @default(autoincrement())
  image       String
  name        String
  description String
  price       Float
  brand       String
  category String @default("product")
}
