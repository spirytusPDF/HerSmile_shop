generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") //don't mind the error. It still works on prisma 6.x.x.
}

model Product {
  id          Int    @id @default(autoincrement())
  image       String
  name        String
  description String
  price       Float
  brand       String
  category    String @default("product")
  cart        Cart?  @relation(fields: [cartId], references: [id])
  cartId      Int?
  order       Order? @relation(fields: [orderId], references: [id])
  orderId     Int?
}

model User {
  id       Int     @id @default(autoincrement())
  login    String
  password String
  cart     Cart?
  orders   Order[]
}

model Cart {
  id     Int       @id @default(autoincrement())
  userId Int       @unique
  user   User      @relation(fields: [userId], references: [id])
  items  Product[]
}

model Order {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  items     Product[]
  total     Float
  createdAt DateTime  @default(now())
}

